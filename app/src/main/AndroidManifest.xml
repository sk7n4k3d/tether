<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Android 17 (API 37) : l'acces au reseau local est bloque par defaut pour les apps
      ciblant SDK 37+. Sans cette permission, toute connexion vers une adresse privee
      (10.x, 192.168.x) est abandonnee SANS erreur explicite. Obligatoire pour joindre
      le serveur opencode de le serveur sur 192.0.2.10.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
      Notifications. ⚠️ Obligatoire depuis Android 13 : sans elle, `notify()` ne leve PAS,
      il ne se passe simplement rien (constat classique, et couteux a diagnostiquer).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      UnifiedPush. ⚠️ WAKE_LOCK, <queries> et le service foreground sont deja declares par
      la bibliotheque `org.unifiedpush.android:connector` : ne PAS les redupliquer, un doublon
      casse le routage des intents.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />


    <application
        android:name=".TetherApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Tether"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Tether">
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Receveur de push UnifiedPush.

          ⚠️ `PushService` est le contrat a implementer ; NE PAS declarer en plus un
          `MessagingReceiver` : la bibliotheque embarque deja `internal.MessagingReceiverImpl`
          (exporte, priorite -500) qui route vers ce service. Un second receiver entrerait en
          concurrence et casserait la reception.

          `exported="false"` : seul le distributeur (ntfy), qui est sur l'appareil, doit
          pouvoir atteindre ce service — via l'intent interne de la bibliotheque.
        -->
        <service
            android:name=".push.TetherPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
