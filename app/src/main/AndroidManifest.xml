<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Android 17 (API 37) : l'acces au reseau local est bloque par defaut pour les apps
      ciblant SDK 37+. Sans cette permission, toute connexion vers une adresse privee
      (10.x, 192.168.x) est abandonnee SANS erreur explicite. Obligatoire pour joindre
      le serveur opencode de le serveur sur 192.0.2.10.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />


    <application
        android:name=".TetherApp"
        android:allowBackup="false"
        android:label="Tether"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Tether">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
