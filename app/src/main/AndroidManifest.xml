<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Android 17 (API 37) : l'acces au reseau local est bloque par defaut pour les apps
      ciblant SDK 37+. Sans cette permission, toute connexion vers une adresse privee
      (10.x, 192.168.x) est abandonnee SANS erreur explicite. Obligatoire pour joindre
      le serveur opencode de le serveur sur 192.0.2.10.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
      Notifications. ⚠️ Obligatoire depuis Android 13 : sans elle, `notify()` ne leve PAS,
      il ne se passe simplement rien (constat classique, et couteux a diagnostiquer).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      UnifiedPush. ⚠️ WAKE_LOCK, <queries> et le service foreground sont deja declares par
      la bibliotheque `org.unifiedpush.android:connector` : ne PAS les redupliquer, un doublon
      casse le routage des intents.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />


    <application
        android:name=".TetherApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Tether"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Tether">
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustNothing"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Deep link des notifications : `opencode://session/<sessionID>`.
              C'est le format envoye par le plugin opencode (en-tete `Click` de ntfy).
              ⚠️ `launchMode="singleTop"` est indispensable : sans lui, taper une
              notification alors que l'app tourne cree une DEUXIEME activite au lieu de
              livrer un `onNewIntent` a celle qui existe. La pile s'empile et le bouton
              retour devient incoherent.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="opencode" android:host="session" />
                <!--
                  Appairage : `opencode://pair?s=<serveur>&t=<jeton>`, encode dans le QR
                  que le TUI affiche. Le serveur et le jeton sont dans la **query**, pas
                  dans le chemin.

                  Meme filtre que `session`, donc meme schema : Android fait le produit
                  des `data`, et les deux couples (opencode, session) et (opencode, pair)
                  sont exactement ceux voulus. Deux filtres distincts auraient produit la
                  meme chose, en plus long.
                -->
                <data android:scheme="opencode" android:host="pair" />
            </intent-filter>
        </activity>

        <!--
          Boutons de decision sur la notification d'autorisation.

          ⚠️ `exported="false"` : ce receiver repond a une demande d'autorisation sur la
          machine de l'utilisateur. L'exposer autoriserait n'importe quelle app a approuver a sa
          place — un bouton `Toujours autoriser` declenche par une autre application. Il n'est
          atteignable que par l'app elle-meme (PendingIntent explicite, `FLAG_IMMUTABLE`).

          ⚠️ Aucun `intent-filter` : le receiver est cible **nominativement** par
          `Intent(context, PermissionActionReceiver::class.java)`. Un filtre le rendrait
          atteignable par action, donc exportable de fait.
        -->
        <receiver
            android:name=".push.PermissionActionReceiver"
            android:exported="false" />

        <!--
          Receveur de push UnifiedPush.

          ⚠️ `PushService` est le contrat a implementer ; NE PAS declarer en plus un
          `MessagingReceiver` : la bibliotheque embarque deja `internal.MessagingReceiverImpl`
          (exporte, priorite -500) qui route vers ce service. Un second receiver entrerait en
          concurrence et casserait la reception.

          `exported="false"` : seul le distributeur (ntfy), qui est sur l'appareil, doit
          pouvoir atteindre ce service — via l'intent interne de la bibliotheque.
        -->
        <service
            android:name=".push.TetherPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <!--
          FileProvider : necessaire pour partager un export Markdown.

          ⚠️ Sans lui, `FileProvider.getUriForFile` leve une exception et l'export echoue en
          silence (l'erreur est seulement tracee). Un `content://` est la SEULE facon de donner
          un fichier a une autre app sans permission de stockage : passer un `file://` ferait
          planter le receveur sur Android 7+ (FileUriExposedException).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
