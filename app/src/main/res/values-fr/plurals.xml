<?xml version="1.0" encoding="utf-8"?>
<!--
  Les pluriels, en francais. Meme jeu de cles que `values/plurals.xml` — ce que
  verifie `PlurielTest`.

  La difference avec l'anglais n'est pas cosmetique : la forme `one` couvre **0 et 1**
  en francais. Une implementation qui l'ignore affiche « 0 session » et « 1
  session » avec un « s ».
-->
<resources>
    <plurals name="sessions">
        <item quantity="one">%1$d session</item>
        <item quantity="other">%1$d sessions</item>
    </plurals>

    <plurals name="message">
        <item quantity="one">%1$d message</item>
        <item quantity="other">%1$d messages</item>
    </plurals>
    <plurals name="message_prochain_tour">
        <item quantity="one">%1$d message partira au prochain tour</item>
        <item quantity="other">%1$d messages partiront au prochain tour</item>
    </plurals>

    <plurals name="formulaire">
