<?xml version="1.0" encoding="utf-8"?>
<!--
  Tether — calque avant de l'adaptive icon.
  Concept : DEUX NOEUDS RELIES PAR UNE CORDE TENDUE (le sens de "tether").
  Le noeud de gauche est PLEIN (le telephone), celui de droite est un ANNEAU (le PC).

  Contraintes respectees (spec Android adaptive icons) :
    - canvas 108x108 dp
    - safe zone 66 dp centree  ->  contenu critique entre 21 et 87
    - artwork 58 dp (25 -> 83)  ->  dans la plage recommandee 48-66 dp
  Vectoriel : aucun risque de rognage par les masks OEM.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- La corde tendue, entre les deux noeuds -->
    <path
        android:pathData="M43,54 L65,54"
        android:strokeColor="#2DD4BF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Noeud "telephone" : disque plein -->
    <path
        android:pathData="M34,54 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0"
        android:fillColor="#2DD4BF" />

    <!-- Noeud "PC" : anneau -->
    <path
        android:pathData="M74,54 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0"
        android:strokeColor="#2DD4BF"
        android:strokeWidth="5"
        android:fillColor="#00000000" />
</vector>
